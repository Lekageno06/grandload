{
  "manifest_version": 3,
  "name": "Grandload",
  "version": "0.2.0",
  "description": "Extrait, filtre et télécharge liens, médias et chapitres de webtoons et mangas.",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "offscreen", "sidePanel"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": { "default_title": "Grandload" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
