{
  "manifest_version": 3,
  "name": "Grandload",
  "version": "0.1.0",
  "description": "Extrait, filtre et télécharge liens, médias et chapitres de webtoons et mangas.",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "offscreen"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grandload"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
